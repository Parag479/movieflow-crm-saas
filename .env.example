# Database connection URL (PostgreSQL Prisma connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movieflow_crm?schema=public"

# JWT Authentication Secret Keys
JWT_SECRET="movieflow-super-secret-jwt-key-2026-production"
